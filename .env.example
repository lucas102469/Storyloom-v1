# 실제 키는 로컬 .env 또는 Render 환경변수에만 설정하세요.
GEMINI_API_KEY=replace_with_your_key
# 선택 항목: 기본 모델과 호출 한도를 그대로 사용하려면 생략하세요.
# STORYLOOM_MODEL=gemini-3.5-flash-lite
# USER_DAILY_LIMIT=60
# TOTAL_DAILY_LIMIT=400
# STORYLOOM_DB=storyloom.sqlite3
# RENDER_EXTERNAL_HOSTNAME은 Render가 제공하는 실제 호스트명입니다. 로컬에서는 설정하지 마세요.
